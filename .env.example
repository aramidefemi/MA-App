# Supabase (Ma Editor) — copy to .env and fill in
VITE_SUPABASE_URL=https://xmehatovmiaeibkprvfq.supabase.co
VITE_SUPABASE_ANON_KEY=

# AI: proxied via Supabase Edge Function. Shared NVIDIA key is a Supabase secret only.
# BYOK: users save their NVIDIA key in Settings; stored in Supabase (not sent from client).
# Set NVIDIA_API_KEY on Supabase: supabase secrets set NVIDIA_API_KEY=nvapi-...
# Optional: override model (default: nvidia/llama-3.1-nemotron-nano-8b-v1 — fast)
# VITE_AI_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# Optional: database password for CLI/migrations (not used by the Vite app)
# supabase_db_password=
